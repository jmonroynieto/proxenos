<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Proxenos</vendor>
  <vendor_url>https://github.com/jmonroynieto/proxenos</vendor_url>

  <!-- Without this file pkexec still works, but its prompt can say no more
       than "authenticate to run /usr/bin/proxenos-router as root". The action
       below only replaces that wording with something a reader can judge; it
       asks for the same administrator authentication, and does not remember
       the answer. -->
  <action id="org.proxenos.router">
    <description>Route *.proxenos names to local services</description>
    <message>Authentication is required to answer DNS on port 53 and forward HTTP on port 80.</message>
    <icon_name>proxenos</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/proxenos-router</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
